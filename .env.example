DEBUG=<true-or-false>
SECRET_KEY=<your-django-secret-key>
ALLOWED_HOSTS=<comma-separated-hosts>
CORS_ALLOWED_ORIGINS=<comma-separated-origins>

# Docker/runtime ports and bind hosts
BACKEND_BIND_HOST=<backend-bind-host>
BACKEND_PORT=<backend-port>
FRONTEND_BIND_HOST=<frontend-bind-host>
FRONTEND_PORT=<frontend-port>
POSTGRES_PORT=<postgres-port>
POSTGRES_HOST_PORT=<postgres-host-port>
REDIS_PORT=<redis-port>
REDIS_HOST_PORT=<redis-host-port>
VITE_API_BASE_URL=<frontend-api-base-url>

# Database
POSTGRES_DB=<postgres-database-name>
POSTGRES_USER=<postgres-username>
POSTGRES_PASSWORD=<postgres-password>
POSTGRES_HOST=<postgres-host>

# Optional override if you prefer a single connection string:
# DATABASE_URL=postgres://<postgres-username>:<postgres-password>@<postgres-host>:<postgres-port>/<postgres-database-name>

# Redis / Celery
REDIS_URL=redis://<redis-host>:<redis-port>/0
CELERY_BROKER_URL=redis://<redis-host>:<redis-port>/0
CELERY_RESULT_BACKEND=redis://<redis-host>:<redis-port>/1
CELERY_TASK_DEFAULT_QUEUE=<celery-default-queue>

# Ingestion V2
EXTRACTION_VERSION=<V1-or-V2>
INGESTION_V2_CHUNK_QUEUE=<ingestion-v2-queue-name>
INGESTION_V2_MAX_PARALLEL_CHUNK_TASKS=<max-parallel-chunk-tasks>
EXTRACTION_MAX_ENTITIES=20
EXTRACTION_MAX_CLAIMS=30
EXTRACTION_MAX_RELATIONSHIPS=20
EXTRACTION_MAX_OUTPUT_TOKENS=2048

# Auto-repair scheduler
AUTO_REPAIR_BEAT_INTERVAL_MINUTES=<auto-repair-beat-interval-minutes>

# Default LLM selection
DEFAULT_LLM_PROVIDER=<default-llm-provider>
DEFAULT_LLM_MODEL=<default-llm-model>

# Provider keys
GOOGLE_API_KEY=<google-api-key>
ANTHROPIC_API_KEY=<anthropic-api-key>
OPENAI_API_KEY=<openai-api-key>

# OpenAI-specific model defaults used by parts of the app
OPENAI_EMBEDDING_MODEL=<openai-embedding-model>
OPENAI_CHAT_MODEL=<openai-chat-model>

# Upload and app tuning
MAX_UPLOAD_MB=<max-upload-mb>

# Optional observability
LANGSMITH_TRACING=<true-or-false>
LANGSMITH_ENDPOINT=<langsmith-endpoint>
LANGSMITH_API_KEY=<langsmith-api-key>
LANGSMITH_PROJECT=<langsmith-project-name>
