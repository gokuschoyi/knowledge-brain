{
    "snyk.advanced.autoSelectOrganization": true,
    "editor.tabSize": 2,
    "editor.insertSpaces": true,
    "eslint.validate": [
        "javascript",
        "javascriptreact",
        "typescript",
        "typescriptreact"
    ],
    "editor.codeActionsOnSave": {
        "source.fixAll.eslint": "explicit"
    },
    "eslint.workingDirectories": [
        {
            "mode": "auto"
        }
    ]
}